[Unit]
Description=AI Media Factory autonomous engineering daily summary
After=ai-media-factory-agent.service

[Service]
Type=oneshot
User=amf-agent
Group=amf-agent
WorkingDirectory=/opt/ai-media-factory-dev
Environment=AMF_AGENT_ROOT=/opt/ai-media-factory-dev
EnvironmentFile=-/etc/ai-media-factory-agent/agent.env
UMask=0077
ExecStartPre=/usr/bin/sha256sum --check --quiet /etc/ai-media-factory-agent/policy.sha256
ExecStart=/usr/bin/npm run agent:daily-summary
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ai-media-factory-dev/agent/reports
InaccessiblePaths=-/opt/ai-media-factory/current -/var/lib/ai-media-factory -/var/run/docker.sock -/home/amf-agent/.ssh -/home/amf-agent/.config/gcloud
IPAddressDeny=169.254.169.254
