{
  "name": "ai-media-factory",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently -k -n web,worker -c blue,green \"npm:dev\" \"npm:worker:dev\"",
    "build": "next build",
    "start": "next start",
    "worker": "tsx worker/run.ts",
    "worker:dev": "tsx watch worker/run.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "agent:gate": "tsx scripts/engineering-gate.ts",
    "agent:orchestrator": "tsx scripts/agent-orchestrator.ts",
    "agent:once": "tsx scripts/agent-orchestrator.ts --once",
    "agent:health": "tsx scripts/agent-healthcheck.ts",
    "agent:verify-sandbox": "tsx scripts/agent-verify-sandbox.ts",
    "agent:daily-summary": "tsx scripts/agent-daily-summary.ts",
    "agent:validate-task": "tsx scripts/agent-validate-task.ts",
    "agent:verify-audit": "tsx scripts/agent-verify-audit.ts",
    "bot": "tsx src/telegram/bot.ts"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "file-type": "22.0.1",
    "next": "16.2.10",
    "node-telegram-bot-api": "^1.2.0",
    "os-utils": "^0.0.14",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.1",
    "@types/node-telegram-bot-api": "^0.64.15",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "concurrently": "10.0.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.10",
    "jsdom": "29.1.1",
    "tsx": "4.23.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "8.5.16"
  }
}
