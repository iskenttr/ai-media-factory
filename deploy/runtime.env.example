SESSION_SECRET=set-outside-repository
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
GOOGLE_CLOUD_PROJECT=open-claw-502114
AMF_TTS_PROVIDER=google-cloud
AMF_TTS_LOCALES=tr-TR
AMF_TTS_USAGE_LEDGER=/var/lib/ai-media-factory/tts-usage.jsonl
AMF_TTS_DAILY_CHARACTER_LIMIT=100000
AMF_TTS_DAILY_COST_LIMIT_USD=0.5
SHERPA_ONNX_PYTHON=/var/lib/ai-media-factory-models/sherpa-onnx/venv/bin/python
SHERPA_ONNX_RUNNER=/opt/ai-media-factory-runtime/current/lib/providers/adapters/sherpa-onnx/run_diarization.py
SHERPA_ONNX_SEGMENTATION_MODEL=/var/lib/ai-media-factory-models/sherpa-onnx/sherpa-onnx-pyannote-segmentation-3-0/model.onnx
SHERPA_ONNX_EMBEDDING_MODEL=/var/lib/ai-media-factory-models/sherpa-onnx/3dspeaker_speech_eres2net_base_sv_zh-cn_3dspeaker_16k.onnx
ARGOS_TRANSLATE_COMMAND=/opt/ai-media-factory-runtime/current/scripts/argos-translate-native
ARGOS_PYTHON=/var/lib/ai-media-factory-models/argos/venv/bin/python
ARGOS_PACKAGES_DIR=/var/lib/ai-media-factory-models/argos/packages
